# ---------------------------------------------------------------------------
# DriveNow backend configuration
#
# Copy to `.env` and adjust. Only DATABASE_URL is strictly required — every
# other value has a working default so a fresh clone runs immediately.
# ---------------------------------------------------------------------------

# ---- Server ----
# Port the HTTP API listens on.
PORT=8080

# Public origin of the SPA. Absolute links (password resets) are built from it.
# Local dev default shown; use your real frontend origin in production.
APP_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the API from a browser.
# Defaults to "*" when unset, which is fine for local development. In
# production set this to your real frontend origin, e.g.
#   CORS_ORIGINS=https://drivenow.example.com
CORS_ORIGINS=*

# ---- Database ----
# PostgreSQL connection string. Neon, Supabase, RDS and a local Postgres all
# work — anything the pgx driver can reach.
#   Neon:  postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#   Local: postgresql://postgres:postgres@localhost:5432/drivenow?sslmode=disable
DATABASE_URL=postgresql://user:password@host/drivenow?sslmode=require

# Set RESEED=true once to wipe every application table and rebuild the demo
# dataset. Leave unset in normal operation — the seed is idempotent and will
# not duplicate rows on restart.
# RESEED=false

# ---- Authentication ----
# Signing secret for the console JWTs. Set it in any real deployment: if it is
# left unset the API generates a random secret for the lifetime of the process,
# which is safe but signs every user out on each restart.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-32ch

# Whether visitors may create their own console account at /register.
# Registered accounts receive the least-privileged `operator` role.
# Enabled for the local demo; set to false for production deployments.
ALLOW_REGISTRATION=true

# ---- Outgoing mail (password resets) ----
# When SMTP_HOST is unset the API runs in demo mode: the reset link is
# returned in the response and shown on screen, so the flow works without a
# mail server. Configure these to e-mail reset links instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587              # 587 (STARTTLS) or 465 (implicit TLS)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.com

# ---- Payments (Xendit) ----
# Mock mode (the default) simulates invoices so the entire checkout flow runs
# with no credentials. Set XENDIT_MOCK=false and supply a secret key to take
# real payments.
XENDIT_MOCK=true
XENDIT_SECRET_KEY=

# Token Xendit echoes back in the `x-callback-token` header.
#
# Required in BOTH modes: the webhook fails closed rather than accepting a
# callback it cannot verify, because a verified callback is what marks a
# booking paid and writes the income row. Register the same value in the Xendit
# dashboard. Generate one with:  openssl rand -hex 32
XENDIT_CALLBACK_TOKEN=change-me-to-a-long-random-string

# Override only when pointing at a Xendit sandbox or a proxy.
# XENDIT_BASE_URL=https://api.xendit.co

# ---- Business rules ----
# Currency used for stored prices, invoices, AND every price rendered by the
# frontend — the SPA reads it from GET /api/config at boot, so this is the only
# place the currency is defined. Changing it here is enough; there is no
# matching frontend constant to update. (ISO 4217, e.g. USD, EUR, IDR, GBP.)
CURRENCY=USD

# Late fee charged per overdue day, as a fraction of the vehicle's daily price.
# 0.5 = half of one day's rental charged per day late. Also exposed to the
# frontend via GET /api/config.
LATE_FEE_MULTIPLIER=0.5