# Server
PORT=8080

# Public origin of the SPA — used to build password-reset links.
APP_URL=http://localhost:5173

# JWT signing secret (change this in production!)
JWT_SECRET=local-dev-only-signing-key-32-chars-min

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:npg_3RBe8gYKyUAk@ep-snowy-butterfly-b3lu4kzu-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Currency used by both stored prices and Xendit invoices.
CURRENCY=USD

# Self-service console registration (demo convenience).
# Set to false for production deployments.
ALLOW_REGISTRATION=true

# ---- Xendit payments ----
XENDIT_MOCK=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=dev-callback-token-do-not-use-in-production

# ---- Outgoing mail (optional) ----
# Leave SMTP_HOST empty for demo mode: password-reset links are returned in
# the API response and shown on screen instead of being e-mailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Late fee ----
LATE_FEE_MULTIPLIER=0.5